; vcad — CSG geometry types for parametric CAD
;
; All geometry is represented as pure data (ADTs).
; The vcad kernel evaluates these trees into meshes.
;
; Convenience constructors use [let name [fn ...]] (closures) so that
; ADT constructors from [type] are captured in the closure env and
; remain available when called from other modules.
;
; Functions that take a solid/subject use it as the LAST parameter
; for thread-last pipe compatibility:
;   [pipe [cube 50 30 5] [fillet 1.0] [translate 10 0 0]]

; ---------------------------------------------------------------------------
; Solid — the CSG tree
; ---------------------------------------------------------------------------

[type Solid
  ; Primitives
  [Cube f64 f64 f64]
  [Cylinder f64 f64]
  [Sphere f64]
  [Cone f64 f64 f64]
  [Torus f64 f64]
  [Wedge f64 f64 f64]
  [Prism f64 f64 f64]
  ; Empty (identity for union)
  Empty
  ; Booleans
  [Union Solid Solid]
  [Difference Solid Solid]
  [Intersection Solid Solid]
  ; Transforms
  [Translate Solid f64 f64 f64]
  [Rotate Solid f64 f64 f64]
  [Scale Solid f64 f64 f64]
  [Mirror Solid f64 f64 f64 f64 f64 f64]
  ; Features
  [Extrude Sketch f64 f64 f64]
  [Revolve Sketch f64 f64 f64 f64 f64 f64 f64]
  [Shell Solid f64]
  [Fillet Solid f64]
  [Chamfer Solid f64]
  ; Sweep/Loft
  [SweepLine Sketch f64 f64 f64 f64 f64 f64]
  [SweepHelix Sketch f64 f64 f64 f64]
  [Loft (Vec Sketch)]
  [LoftClosed (Vec Sketch)]
  ; Patterns
  [LinearPattern Solid f64 f64 f64 Int f64]
  [CircularPattern Solid f64 f64 f64 f64 f64 f64 Int f64]
  ; Fasteners — catalog-backed hardware, oriented by its own axis.
  ; [Fastener spec style fx fy fz tx ty tz stack]
  [Fastener Str Str f64 f64 f64 f64 f64 f64 (Vec Str)]
  ; [BoltCircle spec style bcd count cx cy cz ax ay az grip stack]
  [BoltCircle Str Str f64 Int f64 f64 f64 f64 f64 f64 f64 (Vec Str)]
  ; Hole tools, sized from the same thread designation as the fastener.
  ; [ClearanceHole size depth ox oy oz dx dy dz]
  [ClearanceHole Str f64 f64 f64 f64 f64 f64 f64]
  [TappedHole Str f64 f64 f64 f64 f64 f64 f64]]

; ---------------------------------------------------------------------------
; Sketch — 2D profiles for extrude/revolve
; ---------------------------------------------------------------------------

[type SketchSeg
  [SLine f64 f64 f64 f64]
  [SArc f64 f64 f64 f64 f64 f64 Bool]]

[type Sketch
  [Sketch f64 f64 f64 f64 f64 f64 f64 f64 f64 (Vec SketchSeg)]]

; ---------------------------------------------------------------------------
; Material — PBR surface properties
; ---------------------------------------------------------------------------

[type Material
  [Material Str f64 f64 f64 f64 f64]]

; ---------------------------------------------------------------------------
; Scene output
; ---------------------------------------------------------------------------

[type SceneEntry
  [SceneEntry Solid Str]]

; ---------------------------------------------------------------------------
; Convenience constructors (closures — capture ADT constructors)
;
; Subject-last for pipe: [pipe solid [fillet 1.0] [translate 10 0 0]]
; ---------------------------------------------------------------------------

; Primitives (no subject — these create new geometry)
[let cube [fn [x y z] [Cube x y z]]]
[let cylinder [fn [r h] [Cylinder r h]]]
[let sphere [fn [r] [Sphere r]]]
[let cone [fn [r-bottom r-top h] [Cone r-bottom r-top h]]]
[let torus [fn [major-r minor-r] [Torus major-r minor-r]]]
[let wedge [fn [x y z] [Wedge x y z]]]
[let prism [fn [sides radius height] [Prism sides radius height]]]

; Booleans (subject-last: [pipe body [difference tool]] → subtract tool from body)
[let union [fn [other s] [Union s other]]]
[let difference [fn [tool s] [Difference s tool]]]
[let intersection [fn [other s] [Intersection s other]]]

; Transforms (subject-last)
[let translate [fn [x y z s] [Translate s x y z]]]
[let rotate [fn [rx ry rz s] [Rotate s rx ry rz]]]
[let scale [fn [sx sy sz s] [Scale s sx sy sz]]]
; mirror across a plane through (ox,oy,oz) with normal (nx,ny,nz)
[let mirror [fn [ox oy oz nx ny nz s] [Mirror s ox oy oz nx ny nz]]]

; Sketch (no subject — creates new geometry)
[let sketch [fn [ox oy oz xx xy xz yx yy yz segs]
  [Sketch ox oy oz xx xy xz yx yy yz segs]]]
[let line [fn [x1 y1 x2 y2] [SLine x1 y1 x2 y2]]]
[let arc [fn [x1 y1 x2 y2 cx cy ccw] [SArc x1 y1 x2 y2 cx cy ccw]]]

; Extrude/Revolve (subject-last: sketch is the subject)
[let extrude [fn [dx dy dz sk] [Extrude sk dx dy dz]]]
[let revolve [fn [aox aoy aoz adx ady adz angle sk]
  [Revolve sk aox aoy aoz adx ady adz angle]]]

; Sweep (subject-last: sketch is the subject)
; sweep-line: sweep along a straight line path
;   start/end are Vec3, subject is sketch
[let sweep-line [fn [sx sy sz ex ey ez sk]
  [SweepLine sk sx sy sz ex ey ez]]]
; sweep-helix: sweep along a helical path
;   radius, pitch, height, turns
[let sweep-helix [fn [radius pitch height turns sk]
  [SweepHelix sk radius pitch height turns]]]
; Loft (takes a Vec of sketches)
[let loft [fn [sketches] [Loft sketches]]]
[let loft-closed [fn [sketches] [LoftClosed sketches]]]

; Features (subject-last)
[let shell [fn [t s] [Shell s t]]]
[let fillet [fn [r s] [Fillet s r]]]
[let chamfer [fn [d s] [Chamfer s d]]]

; Patterns (subject-last)
[let linear-pattern [fn [dx dy dz count spacing s]
  [LinearPattern s dx dy dz count spacing]]]
[let circular-pattern [fn [ox oy oz ax ay az count angle s]
  [CircularPattern s ox oy oz ax ay az count angle]]]

; ---------------------------------------------------------------------------
; Fasteners — one form per fastener, oriented by its axis.
;
; The head is NOT a separate rotate: [bolt] builds head + shaft as one solid
; and aligns it to the from→to axis, so mirroring a subassembly mirrors the
; fastener with it and the head stays on the side of the flange it belongs to.
;
;   from-point = the face the head bears against (for "flat", the flush face)
;   to-point   = where the shaft tip lands
;   the distance between them is the GRIP, and the catalog length is checked
;   against it — a bolt that is too short or too long for its stack is an
;   error, not a render.
;
; Styles: "shcs" (ISO 4762), "bhcs" (ISO 7380), "flat" (ISO 10642 —
; genuinely countersunk, zero protrusion).
;
; Every placed fastener emits a {catalog_id, qty} line onto the document, so
; bom_create reads the count off the geometry instead of off your memory.
;
;   [bolt "M4x12" "shcs" 10 0 5  10 0 -3]
;   [bolt-stacked "M4x25" "shcs" 0 0 8  0 0 -8 #["washer" "nut"]]
;   [bolt-circle "M4x12" "shcs" 60 6  0 0 10  0 0 -1  8]
[let bolt [fn [spec style fx fy fz tx ty tz]
  [Fastener spec style fx fy fz tx ty tz #[]]]]
; Same, with washers/nuts sharing the axis. Washers before the first "nut"
; sit under the head; the nut (and any washer after it) sits past the tip.
; The stack height is added to the length check.
[let bolt-stacked [fn [spec style fx fy fz tx ty tz stack]
  [Fastener spec style fx fy fz tx ty tz stack]]]
; The common case: `count` fasteners evenly spaced on a bolt circle of
; diameter `bcd`, centred at (cx,cy,cz) in the plane normal to (ax,ay,az),
; each driven `grip` mm along that axis. Emits qty = count.
[let bolt-circle [fn [spec style bcd count cx cy cz ax ay az grip]
  [BoltCircle spec style bcd count cx cy cz ax ay az grip #[]]]]
[let bolt-circle-stacked [fn [spec style bcd count cx cy cz ax ay az grip stack]
  [BoltCircle spec style bcd count cx cy cz ax ay az grip stack]]]

; Hole tools — subtract these; the diameter comes from the same thread
; designation as the fastener, so hole and fastener cannot disagree.
;   [pipe plate [difference [clearance-hole "M4" 6 10 0 0  0 0 -1]]]
[let clearance-hole [fn [size depth ox oy oz dx dy dz]
  [ClearanceHole size depth ox oy oz dx dy dz]]]
[let tapped-hole [fn [size depth ox oy oz dx dy dz]
  [TappedHole size depth ox oy oz dx dy dz]]]

; Material (no subject)
[let material [fn [name r g b metallic roughness]
  [Material name r g b metallic roughness]]]

; Scene (no subject)
[let root [fn [solid material-name]
  [SceneEntry solid material-name]]]

; ---------------------------------------------------------------------------
; Assembly — parts, instances, joints, and robot assemblies
; ---------------------------------------------------------------------------

[type JointDef
  ; [RevoluteJoint name ax ay az lo hi parent px py pz child cx cy cz]
  [RevoluteJoint Str f64 f64 f64 f64 f64 Str f64 f64 f64 Str f64 f64 f64]
  ; [PrismaticJoint name ax ay az lo hi parent px py pz child cx cy cz]
  [PrismaticJoint Str f64 f64 f64 f64 f64 Str f64 f64 f64 Str f64 f64 f64]
  ; [FixedJoint name parent px py pz child cx cy cz]
  [FixedJoint Str Str f64 f64 f64 Str f64 f64 f64]
  ; [BallJoint name parent px py pz child cx cy cz]
  [BallJoint Str Str f64 f64 f64 Str f64 f64 f64]]

[type PartEntry [PartEntry Str Solid Str]]
[type InstanceEntry [InstanceEntry Str Str f64 f64 f64]]

[type Assembly
  [Assembly (Vec PartEntry) (Vec InstanceEntry) (Vec JointDef) Str]]

; Assembly constructors
[let part [fn [name solid material-name] [PartEntry name solid material-name]]]
[let instance [fn [name part-name x y z] [InstanceEntry name part-name x y z]]]

; Joint constructors
[let revolute-joint [fn [name ax ay az lo hi parent px py pz child cx cy cz]
  [RevoluteJoint name ax ay az lo hi parent px py pz child cx cy cz]]]
[let prismatic-joint [fn [name ax ay az lo hi parent px py pz child cx cy cz]
  [PrismaticJoint name ax ay az lo hi parent px py pz child cx cy cz]]]
[let fixed-joint [fn [name parent px py pz child cx cy cz]
  [FixedJoint name parent px py pz child cx cy cz]]]
[let ball-joint [fn [name parent px py pz child cx cy cz]
  [BallJoint name parent px py pz child cx cy cz]]]

; Assembly constructor
[let assembly [fn [parts instances joints ground]
  [Assembly parts instances joints ground]]]

; ---------------------------------------------------------------------------
; Simulation configuration (data types for sim pipeline)
; ---------------------------------------------------------------------------

; [SimConfig dt gravity ground_height]
[type SimConfig [SimConfig f64 f64 f64]]
; [TrainConfig n_envs lr gamma epochs]
[type TrainConfig [TrainConfig Int f64 f64 Int]]

[let sim-config [fn [dt gravity ground-height]
  [SimConfig dt gravity ground-height]]]
[let train-config [fn [n-envs lr gamma epochs]
  [TrainConfig n-envs lr gamma epochs]]]

; ---------------------------------------------------------------------------
; ECAD — schematic and PCB types
; ---------------------------------------------------------------------------

; Schematic component: [EcadComponent ref value footprint-id x y rotation]
[type EcadComponent [EcadComponent Str Str Str f64 f64 f64]]
; Schematic wire: [EcadWire x1 y1 x2 y2]
[type EcadWire [EcadWire f64 f64 f64 f64]]
; Net label: [EcadLabel name x y scope]
; scope: "local", "global", or "hierarchical"
[type EcadLabel [EcadLabel Str f64 f64 Str]]

; PCB trace: [EcadTrace x1 y1 x2 y2 width layer net]
[type EcadTrace [EcadTrace f64 f64 f64 f64 f64 Str Str]]
; PCB via: [EcadVia x y diameter drill net]
[type EcadVia [EcadVia f64 f64 f64 f64 Str]]
; PCB footprint: [EcadFootprint ref value footprint-name x y rotation front]
[type EcadFootprint [EcadFootprint Str Str Str f64 f64 f64 Bool]]
; Net: [EcadNet id name]
[type EcadNet [EcadNet Str Str]]
; Design rules: [EcadRules trace-width clearance via-dia via-drill edge-clr hole-to-hole]
[type EcadRules [EcadRules f64 f64 f64 f64 f64 f64]]

; ECAD constructors
[let ecad-component [fn [ref val fp x y rot] [EcadComponent ref val fp x y rot]]]
[let ecad-wire [fn [x1 y1 x2 y2] [EcadWire x1 y1 x2 y2]]]
[let ecad-label [fn [name x y scope] [EcadLabel name x y scope]]]
[let ecad-trace [fn [x1 y1 x2 y2 w layer net] [EcadTrace x1 y1 x2 y2 w layer net]]]
[let ecad-via [fn [x y dia drill net] [EcadVia x y dia drill net]]]
[let ecad-footprint [fn [ref val fp x y rot front] [EcadFootprint ref val fp x y rot front]]]
[let ecad-net [fn [id name] [EcadNet id name]]]
[let ecad-rules [fn [tw clr vdia vdrl eclr h2h] [EcadRules tw clr vdia vdrl eclr h2h]]]
