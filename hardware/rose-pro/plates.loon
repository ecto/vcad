; plates — sheet-plate vocabulary shared by the rose-pro links.
;
; A loon module: every top-level `let` here is an export. rose-pro.loon says
;   [use plates [plate-x plate-y plate-z bore-x bore-y bore-z act-x act-y act-z]]
; and gets these as unqualified names; `[use plates]` gives plates.plate-x.
; Evaluated once, in its own environment, with the vcad library in scope.
;
; Conventions (vcad): Z-up, mm, degrees. cube corner at origin; cylinder axis
; +Z, base at z=0. Subject-last, so [difference tool subject].
;
; Every helper takes a normal axis in its name (-x/-y/-z). u/v are the two
; in-plane axes in x<y<z order, n0..n1 the thickness span.

; ---------------------------------------------------------------- plates ----
; Rounded-rectangle plate. Corner radius r. Built as two overlapping boxes
; plus four corner cylinders - the classic rounded-rect, and every resulting
; face is planar or a simple cylinder.
;
; vcad's boolean time on a plate is NOT monotonic in r: on the same plate
; r=16 and r=25 are 5-10x slower than r=20 (measured: r=8 6.6 s, r=12 5.4 s,
; r=16 23.8 s, r=20 5.2 s, r=25 68.3 s for one link of 3 plates / 26 bores).
; Prefer 20 where the bolt circles allow it.

[let plate-x [fn [n0 n1 u0 u1 v0 v1 r]
  [let t [- n1 n0]]
  [let core [translate n0 [+ u0 r] v0 [cube t [- [- u1 u0] [* 2.0 r]] [- v1 v0]]]]
  [let cross [translate n0 u0 [+ v0 r] [cube t [- u1 u0] [- [- v1 v0] [* 2.0 r]]]]]
  [let cn [fn [cu cv] [translate n0 cu cv [rotate 0.0 90.0 0.0 [cylinder r t]]]]]
  [pipe core [union cross]
        [union [cn [+ u0 r] [+ v0 r]]] [union [cn [+ u0 r] [- v1 r]]]
        [union [cn [- u1 r] [+ v0 r]]] [union [cn [- u1 r] [- v1 r]]]]]]

[let plate-y [fn [n0 n1 u0 u1 v0 v1 r]
  [let t [- n1 n0]]
  [let core [translate [+ u0 r] n0 v0 [cube [- [- u1 u0] [* 2.0 r]] t [- v1 v0]]]]
  [let cross [translate u0 n0 [+ v0 r] [cube [- u1 u0] t [- [- v1 v0] [* 2.0 r]]]]]
  [let cn [fn [cu cv] [translate cu n0 cv [rotate -90.0 0.0 0.0 [cylinder r t]]]]]
  [pipe core [union cross]
        [union [cn [+ u0 r] [+ v0 r]]] [union [cn [+ u0 r] [- v1 r]]]
        [union [cn [- u1 r] [+ v0 r]]] [union [cn [- u1 r] [- v1 r]]]]]]

[let plate-z [fn [n0 n1 u0 u1 v0 v1 r]
  [let t [- n1 n0]]
  [let core [translate [+ u0 r] v0 n0 [cube [- [- u1 u0] [* 2.0 r]] [- v1 v0] t]]]
  [let cross [translate u0 [+ v0 r] n0 [cube [- u1 u0] [- [- v1 v0] [* 2.0 r]] t]]]
  [let cn [fn [cu cv] [translate cu cv n0 [cylinder r t]]]]
  [pipe core [union cross]
        [union [cn [+ u0 r] [+ v0 r]]] [union [cn [+ u0 r] [- v1 r]]]
        [union [cn [- u1 r] [+ v0 r]]] [union [cn [- u1 r] [- v1 r]]]]]]

; ----------------------------------------------------------------- bores ----
; Through-bores, overshooting the plate both ways so the cut exits cleanly.
; Union the bores into ONE tool before differencing: cutting a 13-hole plate
; one bore at a time costs 27 s versus 14 s for identical output.

[let bore-x [fn [d cu cv n0 n1]
  [translate [- n0 2.0] cu cv [rotate 0.0 90.0 0.0 [cylinder [/ d 2.0] [+ [- n1 n0] 4.0]]]]]]
[let bore-y [fn [d cu cv n0 n1]
  [translate cu [- n0 2.0] cv [rotate -90.0 0.0 0.0 [cylinder [/ d 2.0] [+ [- n1 n0] 4.0]]]]]]
[let bore-z [fn [d cu cv n0 n1]
  [translate cu cv [- n0 2.0] [cylinder [/ d 2.0] [+ [- n1 n0] 4.0]]]]]

; ------------------------------------------------------------- actuators ----
; Actuator envelope stand-ins - purchased parts, shown for fit not for
; manufacture. d = envelope diameter, lo..hi the axial span.

[let act-x [fn [d lo hi cu cv] [translate lo cu cv [rotate 0.0 90.0 0.0 [cylinder [/ d 2.0] [- hi lo]]]]]]
[let act-y [fn [d lo hi cu cv] [translate cu lo cv [rotate -90.0 0.0 0.0 [cylinder [/ d 2.0] [- hi lo]]]]]]
[let act-z [fn [d lo hi cu cv] [translate cu cv lo [cylinder [/ d 2.0] [- hi lo]]]]]
