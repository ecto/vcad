{
  "name": "@vcad/mcp",
  "version": "0.9.4",
  "description": "MCP server for vcad CAD operations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vcad-mcp": "dist/index.js",
    "vcad-mcp-http": "dist/http.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./viewer": "./dist/viewer.js",
    "./browser-tools": "./dist/browser-tools.js",
    "./oauth": "./dist/oauth.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:viewer": "vite build --config vite.viewer.config.ts && node scripts/wrap-viewer.mjs",
    "build:live": "vite build --config vite.live.config.ts && node scripts/wrap-live.mjs",
    "build:mech-catalog": "node scripts/gen-mech-catalog.mjs",
    "build": "npm run build:viewer && npm run build:live && npm run build:mech-catalog && tsc --noCheck",
    "typecheck": "npm run build:viewer && npm run build:live && npm run build:mech-catalog && tsc --noEmit",
    "test": "npm run build:mech-catalog && vitest run",
    "serve": "node scripts/serve.mjs",
    "build:npm": "node scripts/build-npm.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@vcad/core": "*",
    "@vcad/engine": "*",
    "@vcad/ir": "*"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^22",
    "@types/three": "^0.184.1",
    "three": "^0.184.0",
    "typescript": "^5.7",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0"
  }
}
