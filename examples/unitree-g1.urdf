<?xml version="1.0"?>
<!--
  Unitree G1 humanoid (simplified, primitives-only).

  Topology and DOF target the public 23-DOF G1 (12 leg + 1 waist yaw +
  10 arm). Link sizing and masses approximate the real robot for a
  plausible simulation; meshes are replaced with boxes and cylinders so
  vcad's URDF importer (which only recognises primitive geometry) can
  build a complete kinematic + inertial tree.

  Frame: root pelvis sits ~0.793 m above the floor, Z up, X forward.

  All <link> elements come before all <joint> elements — this matches
  the ordering robot-arm-2dof.urdf uses and is required by vcad's
  quick-xml-serde based reader (it does not tolerate interleaved
  link/joint siblings).
-->
<robot name="unitree_g1">

  <material name="g1_dark"><color rgba="0.15 0.16 0.18 1.0"/></material>
  <material name="g1_white"><color rgba="0.92 0.92 0.94 1.0"/></material>
  <material name="g1_accent"><color rgba="0.10 0.55 0.95 1.0"/></material>

  <!-- ================ Links ================ -->

  <!-- Pelvis (root) -->
  <link name="pelvis">
    <visual><geometry><box size="0.20 0.18 0.12"/></geometry><material name="g1_white"/></visual>
    <collision><geometry><box size="0.20 0.18 0.12"/></geometry></collision>
    <inertial><mass value="3.50"/><inertia ixx="0.018" ixy="0" ixz="0" iyy="0.020" iyz="0" izz="0.022"/></inertial>
  </link>

  <!-- Left leg -->
  <link name="left_hip_yaw_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <inertial><mass value="0.80"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/></inertial>
  </link>
  <link name="left_hip_roll_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <inertial><mass value="0.80"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/></inertial>
  </link>
  <link name="left_hip_pitch_link">
    <visual><origin xyz="0 0 -0.105"/><geometry><box size="0.07 0.07 0.21"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.105"/><geometry><box size="0.07 0.07 0.21"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.105"/><mass value="1.85"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.0015"/></inertial>
  </link>
  <link name="left_knee_link">
    <visual><origin xyz="0 0 -0.10"/><geometry><box size="0.06 0.06 0.20"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.10"/><geometry><box size="0.06 0.06 0.20"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.10"/><mass value="1.10"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0009"/></inertial>
  </link>
  <link name="left_ankle_pitch_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial><mass value="0.30"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <link name="left_foot_link">
    <visual><origin xyz="0.025 0 -0.025"/><geometry><box size="0.16 0.07 0.025"/></geometry><material name="g1_dark"/></visual>
    <collision><origin xyz="0.025 0 -0.025"/><geometry><box size="0.16 0.07 0.025"/></geometry></collision>
    <inertial><origin xyz="0.025 0 -0.025"/><mass value="0.40"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0009"/></inertial>
  </link>

  <!-- Right leg -->
  <link name="right_hip_yaw_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <inertial><mass value="0.80"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/></inertial>
  </link>
  <link name="right_hip_roll_link">
    <visual><geometry><cylinder radius="0.045" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.06"/></geometry></collision>
    <inertial><mass value="0.80"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0008"/></inertial>
  </link>
  <link name="right_hip_pitch_link">
    <visual><origin xyz="0 0 -0.105"/><geometry><box size="0.07 0.07 0.21"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.105"/><geometry><box size="0.07 0.07 0.21"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.105"/><mass value="1.85"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.0015"/></inertial>
  </link>
  <link name="right_knee_link">
    <visual><origin xyz="0 0 -0.10"/><geometry><box size="0.06 0.06 0.20"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.10"/><geometry><box size="0.06 0.06 0.20"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.10"/><mass value="1.10"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0009"/></inertial>
  </link>
  <link name="right_ankle_pitch_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial><mass value="0.30"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <link name="right_foot_link">
    <visual><origin xyz="0.025 0 -0.025"/><geometry><box size="0.16 0.07 0.025"/></geometry><material name="g1_dark"/></visual>
    <collision><origin xyz="0.025 0 -0.025"/><geometry><box size="0.16 0.07 0.025"/></geometry></collision>
    <inertial><origin xyz="0.025 0 -0.025"/><mass value="0.40"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0009"/></inertial>
  </link>

  <!-- Torso + head -->
  <link name="torso_link">
    <visual><origin xyz="0 0 0.10"/><geometry><box size="0.18 0.30 0.30"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 0.10"/><geometry><box size="0.18 0.30 0.30"/></geometry></collision>
    <inertial><origin xyz="0 0 0.10"/><mass value="6.50"/><inertia ixx="0.10" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.06"/></inertial>
  </link>
  <link name="head_link">
    <visual><geometry><sphere radius="0.085"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><sphere radius="0.085"/></geometry></collision>
    <inertial><mass value="0.90"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>

  <!-- Left arm -->
  <link name="left_shoulder_pitch_link">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.06"/></geometry></collision>
    <inertial><mass value="0.55"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="left_shoulder_roll_link">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.06"/></geometry></collision>
    <inertial><mass value="0.55"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="left_shoulder_yaw_link">
    <visual><origin xyz="0 0 -0.085"/><geometry><box size="0.05 0.05 0.17"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.085"/><geometry><box size="0.05 0.05 0.17"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.085"/><mass value="0.65"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="left_elbow_link">
    <visual><origin xyz="0 0 -0.085"/><geometry><box size="0.045 0.045 0.17"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.085"/><geometry><box size="0.045 0.045 0.17"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.085"/><mass value="0.50"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0003"/></inertial>
  </link>
  <link name="left_wrist_roll_link">
    <visual><geometry><cylinder radius="0.025" length="0.04"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.04"/></geometry></collision>
    <inertial><mass value="0.10"/><inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00004"/></inertial>
  </link>
  <link name="left_hand_link">
    <visual><geometry><box size="0.04 0.06 0.10"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><box size="0.04 0.06 0.10"/></geometry></collision>
    <inertial><mass value="0.20"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/></inertial>
  </link>

  <!-- Right arm -->
  <link name="right_shoulder_pitch_link">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.06"/></geometry></collision>
    <inertial><mass value="0.55"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="right_shoulder_roll_link">
    <visual><geometry><cylinder radius="0.04" length="0.06"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.04" length="0.06"/></geometry></collision>
    <inertial><mass value="0.55"/><inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="right_shoulder_yaw_link">
    <visual><origin xyz="0 0 -0.085"/><geometry><box size="0.05 0.05 0.17"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.085"/><geometry><box size="0.05 0.05 0.17"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.085"/><mass value="0.65"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="right_elbow_link">
    <visual><origin xyz="0 0 -0.085"/><geometry><box size="0.045 0.045 0.17"/></geometry><material name="g1_white"/></visual>
    <collision><origin xyz="0 0 -0.085"/><geometry><box size="0.045 0.045 0.17"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.085"/><mass value="0.50"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0003"/></inertial>
  </link>
  <link name="right_wrist_roll_link">
    <visual><geometry><cylinder radius="0.025" length="0.04"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><cylinder radius="0.025" length="0.04"/></geometry></collision>
    <inertial><mass value="0.10"/><inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.00004"/></inertial>
  </link>
  <link name="right_hand_link">
    <visual><geometry><box size="0.04 0.06 0.10"/></geometry><material name="g1_dark"/></visual>
    <collision><geometry><box size="0.04 0.06 0.10"/></geometry></collision>
    <inertial><mass value="0.20"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/></inertial>
  </link>

  <!-- ================ Joints ================ -->

  <!-- Left leg (6 DOF) -->
  <joint name="left_hip_yaw_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="left_hip_yaw_link"/>
    <origin xyz="0 0.07 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.43" upper="0.43" effort="88" velocity="32"/>
  </joint>
  <joint name="left_hip_roll_joint" type="revolute">
    <parent link="left_hip_yaw_link"/>
    <child link="left_hip_roll_link"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.43" upper="2.53" effort="139" velocity="20"/>
  </joint>
  <joint name="left_hip_pitch_joint" type="revolute">
    <parent link="left_hip_roll_link"/>
    <child link="left_hip_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="2.88" effort="139" velocity="20"/>
  </joint>
  <joint name="left_knee_joint" type="revolute">
    <parent link="left_hip_pitch_link"/>
    <child link="left_knee_link"/>
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.087" upper="2.88" effort="139" velocity="20"/>
  </joint>
  <joint name="left_ankle_pitch_joint" type="revolute">
    <parent link="left_knee_link"/>
    <child link="left_ankle_pitch_link"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87" upper="0.52" effort="35" velocity="32"/>
  </joint>
  <joint name="left_ankle_roll_joint" type="revolute">
    <parent link="left_ankle_pitch_link"/>
    <child link="left_foot_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.26" upper="0.26" effort="35" velocity="32"/>
  </joint>

  <!-- Right leg (6 DOF) -->
  <joint name="right_hip_yaw_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="right_hip_yaw_link"/>
    <origin xyz="0 -0.07 -0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.43" upper="0.43" effort="88" velocity="32"/>
  </joint>
  <joint name="right_hip_roll_joint" type="revolute">
    <parent link="right_hip_yaw_link"/>
    <child link="right_hip_roll_link"/>
    <origin xyz="0 0 -0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.53" upper="0.43" effort="139" velocity="20"/>
  </joint>
  <joint name="right_hip_pitch_joint" type="revolute">
    <parent link="right_hip_roll_link"/>
    <child link="right_hip_pitch_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="2.88" effort="139" velocity="20"/>
  </joint>
  <joint name="right_knee_joint" type="revolute">
    <parent link="right_hip_pitch_link"/>
    <child link="right_knee_link"/>
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.087" upper="2.88" effort="139" velocity="20"/>
  </joint>
  <joint name="right_ankle_pitch_joint" type="revolute">
    <parent link="right_knee_link"/>
    <child link="right_ankle_pitch_link"/>
    <origin xyz="0 0 -0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87" upper="0.52" effort="35" velocity="32"/>
  </joint>
  <joint name="right_ankle_roll_joint" type="revolute">
    <parent link="right_ankle_pitch_link"/>
    <child link="right_foot_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.26" upper="0.26" effort="35" velocity="32"/>
  </joint>

  <!-- Waist + head (1 DOF actuated, head fixed) -->
  <joint name="waist_yaw_joint" type="revolute">
    <parent link="pelvis"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.62" upper="2.62" effort="88" velocity="32"/>
  </joint>
  <joint name="head_fixed_joint" type="fixed">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.34" rpy="0 0 0"/>
  </joint>

  <!-- Left arm (5 DOF actuated, hand fixed) -->
  <joint name="left_shoulder_pitch_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="left_shoulder_pitch_link"/>
    <origin xyz="0 0.155 0.225" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="1.57" effort="40" velocity="32"/>
  </joint>
  <joint name="left_shoulder_roll_joint" type="revolute">
    <parent link="left_shoulder_pitch_link"/>
    <child link="left_shoulder_roll_link"/>
    <origin xyz="0 0.04 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="2.27" effort="40" velocity="32"/>
  </joint>
  <joint name="left_shoulder_yaw_joint" type="revolute">
    <parent link="left_shoulder_roll_link"/>
    <child link="left_shoulder_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.62" upper="2.62" effort="40" velocity="32"/>
  </joint>
  <joint name="left_elbow_joint" type="revolute">
    <parent link="left_shoulder_yaw_link"/>
    <child link="left_elbow_link"/>
    <origin xyz="0 0 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.05" upper="2.27" effort="40" velocity="32"/>
  </joint>
  <joint name="left_wrist_roll_joint" type="revolute">
    <parent link="left_elbow_link"/>
    <child link="left_wrist_roll_link"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.97" upper="1.97" effort="18" velocity="32"/>
  </joint>
  <joint name="left_hand_fixed_joint" type="fixed">
    <parent link="left_wrist_roll_link"/>
    <child link="left_hand_link"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
  </joint>

  <!-- Right arm (5 DOF actuated, hand fixed) -->
  <joint name="right_shoulder_pitch_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="right_shoulder_pitch_link"/>
    <origin xyz="0 -0.155 0.225" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="1.57" effort="40" velocity="32"/>
  </joint>
  <joint name="right_shoulder_roll_joint" type="revolute">
    <parent link="right_shoulder_pitch_link"/>
    <child link="right_shoulder_roll_link"/>
    <origin xyz="0 -0.04 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.27" upper="1.57" effort="40" velocity="32"/>
  </joint>
  <joint name="right_shoulder_yaw_joint" type="revolute">
    <parent link="right_shoulder_roll_link"/>
    <child link="right_shoulder_yaw_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.62" upper="2.62" effort="40" velocity="32"/>
  </joint>
  <joint name="right_elbow_joint" type="revolute">
    <parent link="right_shoulder_yaw_link"/>
    <child link="right_elbow_link"/>
    <origin xyz="0 0 -0.17" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.05" upper="2.27" effort="40" velocity="32"/>
  </joint>
  <joint name="right_wrist_roll_joint" type="revolute">
    <parent link="right_elbow_link"/>
    <child link="right_wrist_roll_link"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.97" upper="1.97" effort="18" velocity="32"/>
  </joint>
  <joint name="right_hand_fixed_joint" type="fixed">
    <parent link="right_wrist_roll_link"/>
    <child link="right_hand_link"/>
    <origin xyz="0 0 -0.05" rpy="0 0 0"/>
  </joint>

</robot>
