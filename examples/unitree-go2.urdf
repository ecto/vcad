<?xml version="1.0"?>
<!--
  Unitree Go2 quadruped (simplified, primitives-only).

  Topology: trunk root + 4 legs × (hip / thigh / calf) = 12 actuated DOF
  with one fixed foot per leg (16 joints total). Link sizing and masses
  follow Unitree's published Go2 specs (~15 kg, ~70 cm long, ~30 cm
  shoulder height standing).

  All <link> elements come before all <joint> elements — vcad's
  quick-xml-serde URDF reader does not tolerate interleaved siblings.
-->
<robot name="unitree_go2">

  <material name="go2_dark"><color rgba="0.10 0.10 0.12 1.0"/></material>
  <material name="go2_white"><color rgba="0.92 0.92 0.94 1.0"/></material>
  <material name="go2_accent"><color rgba="0.90 0.45 0.10 1.0"/></material>

  <!-- ================ Links ================ -->

  <!-- Trunk (root) -->
  <link name="trunk">
    <visual><geometry><box size="0.65 0.10 0.10"/></geometry><material name="go2_white"/></visual>
    <collision><geometry><box size="0.65 0.10 0.10"/></geometry></collision>
    <inertial><mass value="6.92"/><inertia ixx="0.012" ixy="0" ixz="0" iyy="0.13" iyz="0" izz="0.13"/></inertial>
  </link>

  <!-- Front-left leg -->
  <link name="FL_hip">
    <visual><geometry><cylinder radius="0.046" length="0.04"/></geometry><material name="go2_dark"/></visual>
    <collision><geometry><cylinder radius="0.046" length="0.04"/></geometry></collision>
    <inertial><mass value="0.68"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0006"/></inertial>
  </link>
  <link name="FL_thigh">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="1.15"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="FL_calf">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="0.16"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.00006"/></inertial>
  </link>
  <link name="FL_foot">
    <visual><geometry><sphere radius="0.022"/></geometry><material name="go2_accent"/></visual>
    <collision><geometry><sphere radius="0.022"/></geometry></collision>
    <inertial><mass value="0.06"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>

  <!-- Front-right leg -->
  <link name="FR_hip">
    <visual><geometry><cylinder radius="0.046" length="0.04"/></geometry><material name="go2_dark"/></visual>
    <collision><geometry><cylinder radius="0.046" length="0.04"/></geometry></collision>
    <inertial><mass value="0.68"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0006"/></inertial>
  </link>
  <link name="FR_thigh">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="1.15"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="FR_calf">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="0.16"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.00006"/></inertial>
  </link>
  <link name="FR_foot">
    <visual><geometry><sphere radius="0.022"/></geometry><material name="go2_accent"/></visual>
    <collision><geometry><sphere radius="0.022"/></geometry></collision>
    <inertial><mass value="0.06"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>

  <!-- Rear-left leg -->
  <link name="RL_hip">
    <visual><geometry><cylinder radius="0.046" length="0.04"/></geometry><material name="go2_dark"/></visual>
    <collision><geometry><cylinder radius="0.046" length="0.04"/></geometry></collision>
    <inertial><mass value="0.68"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0006"/></inertial>
  </link>
  <link name="RL_thigh">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="1.15"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="RL_calf">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="0.16"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.00006"/></inertial>
  </link>
  <link name="RL_foot">
    <visual><geometry><sphere radius="0.022"/></geometry><material name="go2_accent"/></visual>
    <collision><geometry><sphere radius="0.022"/></geometry></collision>
    <inertial><mass value="0.06"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>

  <!-- Rear-right leg -->
  <link name="RR_hip">
    <visual><geometry><cylinder radius="0.046" length="0.04"/></geometry><material name="go2_dark"/></visual>
    <collision><geometry><cylinder radius="0.046" length="0.04"/></geometry></collision>
    <inertial><mass value="0.68"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0006"/></inertial>
  </link>
  <link name="RR_thigh">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.04 0.05 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="1.15"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0004"/></inertial>
  </link>
  <link name="RR_calf">
    <visual><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry><material name="go2_dark"/></visual>
    <collision><origin xyz="0 0 -0.107"/><geometry><box size="0.025 0.025 0.213"/></geometry></collision>
    <inertial><origin xyz="0 0 -0.107"/><mass value="0.16"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.00006"/></inertial>
  </link>
  <link name="RR_foot">
    <visual><geometry><sphere radius="0.022"/></geometry><material name="go2_accent"/></visual>
    <collision><geometry><sphere radius="0.022"/></geometry></collision>
    <inertial><mass value="0.06"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/></inertial>
  </link>

  <!-- ================ Joints ================ -->

  <!-- Front-left -->
  <joint name="FL_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="FL_hip"/>
    <origin xyz="0.1934 0.0465 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="FL_thigh_joint" type="revolute">
    <parent link="FL_hip"/>
    <child link="FL_thigh"/>
    <origin xyz="0 0.0955 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="3.4907" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="FL_calf_joint" type="revolute">
    <parent link="FL_thigh"/>
    <child link="FL_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.07"/>
  </joint>
  <joint name="FL_foot_fixed_joint" type="fixed">
    <parent link="FL_calf"/>
    <child link="FL_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>

  <!-- Front-right -->
  <joint name="FR_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="FR_hip"/>
    <origin xyz="0.1934 -0.0465 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="FR_thigh_joint" type="revolute">
    <parent link="FR_hip"/>
    <child link="FR_thigh"/>
    <origin xyz="0 -0.0955 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="3.4907" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="FR_calf_joint" type="revolute">
    <parent link="FR_thigh"/>
    <child link="FR_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.07"/>
  </joint>
  <joint name="FR_foot_fixed_joint" type="fixed">
    <parent link="FR_calf"/>
    <child link="FR_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>

  <!-- Rear-left -->
  <joint name="RL_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="RL_hip"/>
    <origin xyz="-0.1934 0.0465 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="RL_thigh_joint" type="revolute">
    <parent link="RL_hip"/>
    <child link="RL_thigh"/>
    <origin xyz="0 0.0955 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="4.5379" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="RL_calf_joint" type="revolute">
    <parent link="RL_thigh"/>
    <child link="RL_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.07"/>
  </joint>
  <joint name="RL_foot_fixed_joint" type="fixed">
    <parent link="RL_calf"/>
    <child link="RL_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>

  <!-- Rear-right -->
  <joint name="RR_hip_joint" type="revolute">
    <parent link="trunk"/>
    <child link="RR_hip"/>
    <origin xyz="-0.1934 -0.0465 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.0472" upper="1.0472" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="RR_thigh_joint" type="revolute">
    <parent link="RR_hip"/>
    <child link="RR_thigh"/>
    <origin xyz="0 -0.0955 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5236" upper="4.5379" effort="23.7" velocity="30.1"/>
  </joint>
  <joint name="RR_calf_joint" type="revolute">
    <parent link="RR_thigh"/>
    <child link="RR_calf"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7227" upper="-0.83776" effort="35.55" velocity="20.07"/>
  </joint>
  <joint name="RR_foot_fixed_joint" type="fixed">
    <parent link="RR_calf"/>
    <child link="RR_foot"/>
    <origin xyz="0 0 -0.213" rpy="0 0 0"/>
  </joint>

</robot>
