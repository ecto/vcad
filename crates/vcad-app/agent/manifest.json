  "version": 2,
  "vision_tools": [
    {
      "function": {
        "description": "Look at the model: returns a rendered image of the scene from a preset view, or from a camera angle given in degrees (azimuth about +Z from the front, elevation above the XY plane). The user's own camera is left where it was.",
        "name": "render_view",
        "parameters": {
          "properties": {
            "azimuth_deg": {
              "type": "number"
            },
            "elevation_deg": {
              "maximum": 85,
              "minimum": -85,
              "type": "number"
            },
            "view": {
              "description": "Preset view; ignored when azimuth_deg/elevation_deg are given.",
              "enum": [
                "current",
                "iso",
                "top",
                "front",
                "right"
              ],
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        }
      },
      "type": "function"
    }
  ]
}
