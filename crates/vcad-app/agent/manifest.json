              "type": "string"
            }
          },
          "required": [
            "child",
            "plane"
          ],
          "type": "object"
        }
      },
      "type": "function"
    },
    {
      "function": {
        "description": "Change parameters of an existing part, e.g. {size:{x:40}} on a cube or {radius:8} on a cylinder.",
        "name": "update",
        "parameters": {
          "properties": {
            "node_id": {
              "description": "Part id (or IR node id).",
              "type": "string"
