{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "vcad",
  "version": "0.9.3",
  "identifier": "com.vcad.desktop",
  "build": {
    "frontendDist": "../../packages/app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../../packages/app",
      "script": "TAURI_DEV=1 npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../packages/app",
      "script": "npm run build"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "vcad",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "focus": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost 'self' https://yteuhwciuxcbjwmabawj.supabase.co wss://yteuhwciuxcbjwmabawj.supabase.co https://us.i.posthog.com https://us-assets.i.posthog.com https://api.github.com http://127.0.0.1:11434; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": ["vcad"],
        "mimeType": "application/x-vcad"
      },
      {
        "ext": ["step", "stp"],
        "mimeType": "application/x-step"
      },
      {
        "ext": ["stl"],
        "mimeType": "model/stl"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["vcad"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBMkMxQjkwOTVCRDY4OUEKUldTYWFMMlZrQnNzdW5KbTArekdTdDNsVEJyeTYvY3A0Ym15cHdiRlNrUDZNQlRmS0tXU0IzQUcK",
      "endpoints": [
        "https://github.com/ecto/vcad/releases/latest/download/latest.json"
      ]
    }
  }
}
